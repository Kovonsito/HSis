{
    "version": "0.2.0",
    "configurations": [
        {
            "name": ".NET Server (HSis.Server)",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "build-server",
            "program": "${workspaceFolder}/HSis.Server/bin/Debug/net10.0-windows/win-x64/HSis.Server.dll",
            "args": [],
            "cwd": "${workspaceFolder}/HSis.Server",
            "console": "internalConsole",
            "stopAtEntry": false,
            "env": {
                "ASPNETCORE_ENVIRONMENT": "Development"
            }
        },
        {
            "name": ".NET UI (HSis.UI)",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "build-ui",
            "program": "${workspaceFolder}/HSis.UI/bin/Debug/net10.0-windows/HSis.UI.exe",
            "args": [],
            "cwd": "${workspaceFolder}/HSis.UI",
            "console": "internalConsole",
            "stopAtEntry": false
        },
        {
            // Use IntelliSense to find out which attributes exist for C# debugging
            // Use hover for the description of the existing attributes
            // For further information visit https://github.com/dotnet/vscode-csharp/blob/main/debugger-launchjson.md
            "name": ".NET Core Launch (console)",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "build-ui",
            // If you have changed target frameworks, make sure to update the program path.
            "program": "${workspaceFolder}/HSis.UI/bin/Debug/net10.0-windows/HSis.UI.dll",
            "args": [],
            "cwd": "${workspaceFolder}/HSis.UI",
            // For more information about the 'console' field, see https://aka.ms/VSCode-CS-LaunchJson-Console
            "console": "internalConsole",
            "stopAtEntry": false
        },
        {
            "name": ".NET Core Attach",
            "type": "coreclr",
            "request": "attach"
        }
    ],
    "compounds": [
        {
            "name": "Servidor + UI (Depuración)",
            "configurations": [
                ".NET Server (HSis.Server)",
                ".NET UI (HSis.UI)"
            ]
        }
    ]
}