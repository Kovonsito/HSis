{
  "ApiSettings": {
    "BaseUrl": "https://localhost"
  },
  "SignalR": {
    "ServerUrl": "https://localhost/notificationHub"
  },
  "NotificationAgent": {
    "PresenceFileName": "ui-presence.json",
    "PresenceTimeoutSeconds": 15,
    "PollIntervalSeconds": 30,
    "RetryInitialSeconds": 10,
    "RetryMaxSeconds": 120,
    "RegisterStartup": true,
    "UIExecutablePath": "..\\UI\\HSis.UI.exe",
    "EnableNativeNotifications": true
  }
}
