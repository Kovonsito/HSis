# ==============================================================================
# HSis - Reglas de exclusión de Git (.gitignore)
# Optimizado exclusivamente para la solución HSis (.NET 10 / C# / WinForms / ASP.NET Core)
# ==============================================================================

# Compilación y salidas de compilación
[Bb]in/
[Oo]bj/
[Oo]ut/
[Bb]uild/
.build/
publish/
PublicacionServer/
Servidor_API/

# Perfiles de publicación de Visual Studio
*.pubxml
*.publishproj

# Visual Studio e IDEs (archivos de usuario, caché y configuraciones locales)
.vs/
.vscode/
*.user
*.userosscache
*.suo
*.sln.docstates
HSis.slnLaunch.user
*.code-workspace

# Resultados y reportes de pruebas
[Tt]est[Rr]esult*/
TestResults/
*.coverage
*.coveragexml

# Archivos de registro (Logs) y temporales
[Ll]ogs/
*.log
*.tmp

# Bases de datos locales y respaldos SQL
HSis.BD/
HSisBD/
*.mdf
*.ldf
*.bak

# Certificados de seguridad y claves generadas para LAN (no versionar)
scripts/lan-cert/
*.cer
*.pfx

# Herramientas de IA y grafos generados localmente
graphify-out/
.agents/

# Archivos del sistema operativo Windows
Thumbs.db
[Dd]esktop.ini
